{
  "expo": {
    "name": "TapToPay",
    "slug": "TapToPay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syscentric.taptopay",
      "infoPlist": {
        "UIBackgroundModes": [
          "bluetooth-central"
        ],
        "NSLocationWhenInUseUsageDescription": "Location access is required to accept contactless payments with Stripe Terminal.",
        "NSBluetoothAlwaysUsageDescription": "Bluetooth access is required to connect to card readers.",
        "NSBluetoothPeripheralUsageDescription": "Bluetooth access is required to connect to card readers."
      }
    },
    "android": {
      "package": "com.syscentric.taptopay",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.NFC"
      ]
    },
    "plugins": [
      [
        "@stripe/stripe-terminal-react-native",
        {
          "tapToPayCheck": true,
          "appDelegate": true,
          "bluetoothBackgroundMode": true,
          "locationWhenInUsePermission": "Location access is required to accept contactless payments with Stripe Terminal.",
          "bluetoothPeripheralPermission": "Bluetooth access is required to connect to card readers."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 30,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/taxi-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e8e852a7-451f-4b51-91a3-a69d3a026c31"
      }
    }
  }
}
